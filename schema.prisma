datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  email                     String?         @unique
  username                  String?         @unique
  isAdmin                   Boolean         @default(false)
  canPublishPublic          Boolean         @default(false)

  name                      String?
  showNamePublicly          Boolean         @default(false)
  avatarUrl                 String?
  headline                  String?
  bio                       String?
  location                  String?
  socialLinks               String?

  paymentProcessorUserId    String?         @unique
  lemonSqueezyCustomerPortalUrl String?     // You can delete this if you're not using Lemon Squeezy as your payments processor.
  subscriptionStatus        String?         // 'active', 'cancel_at_period_end', 'past_due', 'deleted'
  subscriptionPlan          String?         // 'hobby', 'pro'
  datePaid                  DateTime?
  credits                   Int             @default(30)

  contactFormMessages       ContactFormMessage[]
  files                     File[]
  videoTasks                VideoTask[]
  longVideoJobs             LongVideoJob[]
}

model ProcessedWebhookEvent {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  paymentProcessorEventId   String          @unique // The payment processor's event id, e.g. `evt_...` for Stripe.
  eventType                 String                  // The payment processor's event type, e.g. `invoice.paid`.
}

model File {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  name                      String
  type                      String
  s3Key                     String
  isPublic                  Boolean         @default(false)

  @@index([isPublic])
}

model DailyStats {
  id                               Int             @id @default(autoincrement())
  date                             DateTime        @default(now()) @unique

  totalViews                       Int             @default(0)
  prevDayViewsChangePercent        String          @default("0")
  userCount                        Int             @default(0)
  paidUserCount                    Int             @default(0)
  userDelta                        Int             @default(0)
  paidUserDelta                    Int             @default(0)
  totalRevenue                     Float           @default(0)
  totalProfit                      Float           @default(0)

  sources                          PageViewSource[]
}

model PageViewSource {
  @@id([date, name])
  name                     String
  date                     DateTime        @default(now())

  dailyStats               DailyStats?     @relation(fields: [dailyStatsId], references: [id])
  dailyStatsId             Int?

  visitors                 Int
}

model Logs {
  id                       Int             @id @default(autoincrement())
  createdAt                DateTime        @default(now())

  message                  String
  level                    String
}

model ContactFormMessage {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
  isRead                    Boolean         @default(false)
  repliedAt                 DateTime?
}

model VideoTask {
  id                 String    @id @default(uuid())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  provider           String    // "HIGGSFIELD" | "MUAPI"
  model              String    // "seedance-2.5-intl-motion-control" | "higgsfield/genjutsu/motion-transfer/v1.0"
  requestId          String    @unique
  prompt             String?
  sourceVideoUrl     String
  referenceImageUrls String[]
  outputVideoUrl     String?
  resolution         String    @default("720p") // "480p" | "720p" | "1080p"
  status             String    @default("PENDING") // "PENDING" | "PROCESSING" | "COMPLETED" | "FAILED"
  error              String?
  isPublic           Boolean   @default(false)
  featuredOnHome     Boolean   @default(false)
  publicTitle        String?
  publicCategory     String?
  storageKey         String?
  posterUrl          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([isPublic, featuredOnHome])
}

model LongVideoJob {
  id                 String             @id @default(uuid())
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  status             String             @default("SPLITTING") // "SPLITTING" | "PROCESSING_CLIPS" | "AWAITING_APPROVAL" | "STITCHING" | "COMPLETED" | "FAILED"
  variant            String             @default("light")     // "light" | "pro" | "seedance"
  aspectRatio        String?                                  // Seedance only, e.g. "16:9"
  resolution         String             @default("480p")      // "480p" | "720p" | "1080p"
  prompt             String?
  sourceVideoUrl     String
  referenceImageUrls String[]
  trimStartSec       Float              @default(0)
  totalDurationSec   Float
  segmentCount       Int
  completedCount     Int                @default(0)
  creditCost         Int
  creditsRefunded    Boolean            @default(false)
  // Preview-first: only piece 1 is rendered and charged, then the job waits in
  // AWAITING_APPROVAL until the user approves (and pays for) the rest.
  previewFirst       Boolean            @default(false)
  previewVideoUrl    String?
  approvedAt         DateTime?
  // Experimental (LONG_VIDEO_FRAME_CARRYOVER=true): render pieces one after another and
  // pass each piece's last frame to the next as an extra reference image.
  frameCarryover     Boolean            @default(false)
  outputVideoUrl     String?
  outputStorageKey   String?
  error              String?
  segments           LongVideoSegment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

model LongVideoSegment {
  id             String       @id @default(uuid())
  job            LongVideoJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId          String
  index          Int
  startSec       Float
  durationSec    Float
  clipSourceUrl  String?
  requestId      String?      @unique
  attempts       Int          @default(1) // render attempts, incl. automatic retries
  status         String       @default("PENDING") // "PENDING" | "PROCESSING" | "COMPLETED" | "FAILED" | "SKIPPED"
  outputVideoUrl String?
  error          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([jobId, index])
  @@index([status])
}
