---
import "../styles/global.css";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { BRAND, PLAUSIBLE_DOMAIN, SITE_URL } from "../config";
import type { HomepageData } from "../lib/content";
import { fyBoot } from "../lib/experimentBoot.js";
import { experimentBootDefs, experimentCss } from "../lib/experimentCss";
import { abs, graph, organization, website, type JsonLd } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL. Defaults to the current path. */
  path?: string;
  image?: string;
  type?: "website" | "article";
  schema?: JsonLd[];
  noindex?: boolean;
  /** Homepage data, so section order experiments get their CSS. */
  home?: HomepageData;
  published?: Date;
}

const { title, description, image = BRAND.ogImage, type = "website", schema = [], noindex = false, home, published } = Astro.props;
const path = Astro.props.path ?? Astro.url.pathname;
const canonical = path === "/" ? `${SITE_URL}/` : `${SITE_URL}${path.replace(/\/$/, "")}`;
const fullTitle = title.includes(BRAND.name) ? title : `${title} | ${BRAND.name}`;
const ogImage = abs(image);
const bootScript = `(${fyBoot.toString()})(${JSON.stringify(experimentBootDefs())});`;
const css = experimentCss(home);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-video-preview:-1"} />
    <meta name="theme-color" content="#07070a" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/app-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="FAYAA blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@500;600&display=swap"
    />

    <script is:inline set:html={bootScript} />
    {css && <style is:inline set:html={css} />}

    <script type="application/ld+json" is:inline set:html={graph([organization(), website(), ...schema])} />

    {PLAUSIBLE_DOMAIN && <script is:inline defer data-domain={PLAUSIBLE_DOMAIN} src="https://plausible.io/js/script.tagged-events.js" />}
    <slot name="head" />
  </head>
  <body class="min-h-dvh bg-fy-ink text-fy-text antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-fy-accent focus:px-4 focus:py-2 focus:text-fy-on-accent">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
