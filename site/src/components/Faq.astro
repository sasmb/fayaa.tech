---
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = "Questions, answered." } = Astro.props;
---
<section class="mx-auto max-w-3xl px-4 py-20 sm:px-6" aria-labelledby="faq-title">
  <p class="fy-eyebrow">FAQ</p>
  <h2 id="faq-title" class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  <div class="mt-10 divide-y divide-fy-line border-y border-fy-line">
    {items.map((item) => (
      <details class="group py-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-left font-medium">
          <h3>{item.q}</h3>
          <span class="text-fy-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 text-fy-muted">{item.a}</p>
      </details>
    ))}
  </div>
</section>
