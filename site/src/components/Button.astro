---
interface Props {
  href: string;
  variant?: "primary" | "ghost";
  size?: "sm" | "md" | "lg";
  event?: string;
  class?: string;
}
const { href, variant = "primary", size = "md", event, class: className = "" } = Astro.props;
const sizes = { sm: "h-9 px-4 text-sm", md: "h-11 px-6 text-sm", lg: "h-13 px-7 text-base" };
const variants = {
  primary: "bg-fy-accent text-fy-on-accent hover:bg-fy-accent-hover fy-glow",
  ghost: "fy-glass text-fy-text hover:bg-white/10",
};
---
<a
  href={href}
  data-event={event}
  class:list={["inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-colors duration-300", sizes[size], variants[variant], className]}
><slot /></a>
