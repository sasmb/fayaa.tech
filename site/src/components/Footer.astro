---
import { BRAND, app } from "../config";
import { LANDING_PAGES } from "../lib/landingPages";
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
---
<footer class="border-t border-fy-line bg-fy-surface-1">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4">
    <div class="space-y-4">
      <Logo />
      <p class="max-w-xs text-sm text-fy-muted">{BRAND.tagline}. The AI video studio for TikTok, Reels and Shorts.</p>
    </div>
    <div>
      <h2 class="fy-eyebrow mb-4">Use cases</h2>
      <ul class="space-y-2 text-sm text-fy-muted">
        {LANDING_PAGES.map((p) => <li><a href={`/${p.slug}`} class="hover:text-fy-text">{p.nav}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="fy-eyebrow mb-4">Product</h2>
      <ul class="space-y-2 text-sm text-fy-muted">
        <li><a href={app.studio()} class="hover:text-fy-text">Studio</a></li>
        <li><a href="/pricing" class="hover:text-fy-text">Pricing</a></li>
        <li><a href="/blog" class="hover:text-fy-text">Blog</a></li>
        <li><a href={app.signup} class="hover:text-fy-text">Sign up</a></li>
        <li><a href={app.login} class="hover:text-fy-text">Log in</a></li>
      </ul>
    </div>
    <div>
      <h2 class="fy-eyebrow mb-4">Company</h2>
      <ul class="space-y-2 text-sm text-fy-muted">
        <li><a href={app.terms} class="hover:text-fy-text">Terms</a></li>
        <li><a href={app.privacy} class="hover:text-fy-text">Privacy</a></li>
        <li><a href={app.refunds} class="hover:text-fy-text">Refunds</a></li>
        <li><a href={`mailto:${BRAND.supportEmail}`} class="hover:text-fy-text">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-fy-line">
    <p class="mx-auto max-w-7xl px-4 py-6 text-xs text-fy-subtle sm:px-6">© {year} FAYAA. All rights reserved.</p>
  </div>
</footer>
