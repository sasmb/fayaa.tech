---
interface Props { eyebrow: string; title: string; description?: string; id?: string; center?: boolean }
const { eyebrow, title, description, id, center = false } = Astro.props;
---
<div class:list={["max-w-2xl", center && "mx-auto text-center"]}>
  <p class="fy-eyebrow text-fy-accent-300">{eyebrow}</p>
  <h2 id={id} class="mt-3 font-display text-3xl font-bold tracking-tight text-balance sm:text-5xl">{title}</h2>
  {description && <p class="mt-4 text-lg text-fy-muted text-pretty">{description}</p>}
</div>
