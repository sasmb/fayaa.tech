# Public URL of this marketing site (canonical URLs, sitemap, OG tags).
PUBLIC_SITE_URL=https://fayaa.tech
# Where the studio, login and checkout live after the split.
PUBLIC_APP_URL=https://app.fayaa.tech
# Wasp server (Fly). The build reads owner-managed homepage media from
# GET {PUBLIC_API_URL}/api/public/site-media and falls back to the coded clips.
PUBLIC_API_URL=https://fayaa-studio-server.fly.dev
# Optional analytics. Leave empty to ship no analytics script.
PUBLIC_PLAUSIBLE_DOMAIN=
