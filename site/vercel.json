{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/studio",
      "destination": "https://app.fayaa.tech/studio",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "https://app.fayaa.tech/login",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "https://app.fayaa.tech/signup",
      "permanent": true
    },
    {
      "source": "/account",
      "destination": "https://app.fayaa.tech/account",
      "permanent": true
    },
    {
      "source": "/checkout",
      "destination": "https://app.fayaa.tech/checkout",
      "permanent": true
    },
    {
      "source": "/request-password-reset",
      "destination": "https://app.fayaa.tech/request-password-reset",
      "permanent": true
    },
    {
      "source": "/password-reset",
      "destination": "https://app.fayaa.tech/password-reset",
      "permanent": true
    },
    {
      "source": "/email-verification",
      "destination": "https://app.fayaa.tech/email-verification",
      "permanent": true
    },
    {
      "source": "/file-upload",
      "destination": "https://app.fayaa.tech/file-upload",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "https://app.fayaa.tech/admin",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "https://app.fayaa.tech/terms",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "https://app.fayaa.tech/privacy",
      "permanent": true
    },
    {
      "source": "/refunds",
      "destination": "https://app.fayaa.tech/refunds",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "https://app.fayaa.tech/admin/:path*",
      "permanent": true
    },
    {
      "source": "/api/:path*",
      "destination": "https://app.fayaa.tech/api/:path*",
      "permanent": true
    },
    {
      "source": "/auth/:path*",
      "destination": "https://app.fayaa.tech/auth/:path*",
      "permanent": true
    },
    {
      "source": "/operations/:path*",
      "destination": "https://app.fayaa.tech/operations/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
